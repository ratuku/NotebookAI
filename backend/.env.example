DATABASE_URL=postgresql+psycopg://notebook:local_notebook_password@localhost:5433/notebook
CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_BYTES=10485760

# AI runs in the backend process; use one worker with local Qdrant.
AI_MODE=rag
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_PATH=.models
QDRANT_PATH=.qdrant
# Optional externally hosted Qdrant instead of local disk:
# QDRANT_URL=http://localhost:6333
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
