# Generate a URL-safe password, e.g. openssl rand -hex 24.
POSTGRES_PASSWORD=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_MODE=rag
APP_PORT=8080
# Bind to loopback behind your HTTPS/auth reverse proxy.
BIND_ADDRESS=127.0.0.1

# Give each app its own absolute directory on a persistent disk in production.
POSTGRES_DATA_PATH=./data/deploy/postgres18
COMPOSE_PROJECT_NAME=notebookai-deploy
